Options +FollowSymLinks -MultiViews
RewriteEngine On
RewriteBase /lucy/

# Redirect plural events to singular event
RewriteRule ^events/?$ event [R=301,L]

# Serve real files and directories directly
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# If the URL has no extension, internally serve the .php file
RewriteRule ^([^.]+)$ $1.php [L]

ErrorDocument 404 /lucy/404.php
