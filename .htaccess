<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /
Options -MultiViews

# Force redirect direct .php access to extensionless
RewriteCond %{REQUEST_METHOD} ^GET$
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?]
RewriteCond %{REQUEST_URI} !^/callback_url\.php$
RewriteRule ^ /%1 [R=301,L]

# Remove .php extension for static pages (Internal rewrite)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^(.*?)/?$ $1.php [L]
</IfModule>

ErrorDocument 404 /404.php
