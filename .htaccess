RewriteEngine On

# If the request is for a valid directory, let it go
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# If the request is for a valid file, let it go
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Otherwise, try adding .php
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]

# Let Apache use the default 404 if ErrorDocument is not perfectly mapped to root
# (Or on live you can uncomment the line below)
# ErrorDocument 404 /404.php
